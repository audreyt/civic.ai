---
import Default from "../../../layouts/Default.astro";
import { loadPages, type PageRecord } from "../../../lib/pages";
import { record } from "../../../lib/record";
import { ledgerMonthPages } from "../../../lib/recordPages";

export function getStaticPaths() {
    return ledgerMonthPages(record.months(loadPages()))
        .filter((page) => page.url.startsWith("/tw/"))
        .map((page) => ({ params: { month: page.data.ledger_month }, props: { page } }));
}

interface Props { page: PageRecord }
const { page } = Astro.props;
---
<Default page={page} />
