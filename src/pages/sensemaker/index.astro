---
import { getPageByUrl, readRawHtmlDocument } from "../../lib/pages";
import Trace from "../../components/Trace.astro";
import PartnerColophon from "../../components/PartnerColophon.astro";
import { site } from "../../lib/site";
import { readFileSync } from "node:fs";
import { record, recordSources } from "../../lib/record";
const html = readRawHtmlDocument("sensemaker.html");
const page = getPageByUrl("/sensemaker/");
const headEnd = html.indexOf("</head>");
const bodyEnd = html.lastIndexOf("</body>");
const pageLd = { "@context": "https://schema.org", "@type": "WebPage", url: `${site.url}${page.url}`, dateModified: record.summary(recordSources(page))?.amendedDate };
const styles = readFileSync("styles.css", "utf8");
const recordStyles = styles.slice(styles.indexOf("/* ─── THE RECORD:"));
---
<Fragment set:html={html.slice(0, headEnd)} />
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="Amendment ledger" />
<style is:inline set:html={recordStyles}></style>
<script is:inline type="application/ld+json" set:html={JSON.stringify(pageLd)}></script>
<Fragment set:html={html.slice(headEnd, bodyEnd)} />
<Trace page={page} />
<PartnerColophon lang={page.data.lang} url={page.url} />
<Fragment set:html={html.slice(bodyEnd)} />
