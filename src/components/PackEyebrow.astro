---
// Pack eyebrow and governing question above a pack page's title (DESIGN.md §10).
// part="eyebrow" (default) renders the machinery-voice line before the h1;
// part="question" renders the governing question as a standfirst after it.
import type { PageRecord } from "../lib/pages";
import { lang2, packs } from "../lib/site";

interface Props { page: PageRecord; part?: "eyebrow" | "question"; }
const { page, part = "eyebrow" } = Astro.props;
const match = /^\/(?:tw\/)?([1-6])\/$/.exec(page.url);
const pack = match ? packs.find((p) => p.num === Number(match[1])) : undefined;
const zh = lang2(page.data.lang) === "zh";
---
{pack && part === "eyebrow" && (
  <div class="pack-eyebrow">
    <span class="pack-eyebrow__mark" aria-hidden="true"></span>
    {zh ? (
      <span class="pack-eyebrow__text">第{pack.ordinal_zh}力 · <span lang="en-GB">{pack.name_en}</span></span>
    ) : (
      <span class="pack-eyebrow__text">Pack {pack.num} · <span lang="zh-TW">{pack.name_zh}</span></span>
    )}
  </div>
)}
{pack && part === "question" && (
  <p class="pack-question">{zh ? pack.question_tw : pack.question_en}</p>
)}
