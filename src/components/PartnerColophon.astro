---
import { navItems } from "../lib/nav";
import { lang2, site } from "../lib/site";
const zh = lang2(Astro.props.lang) === "zh";
// The foot repeats the masthead, so the end of a long page is never a dead end (DESIGN.md §7.1).
const items = navItems(Astro.props.lang, Astro.props.url ?? "");
---
<section class="partner-colophon" role="contentinfo" aria-label={zh ? "合作機構" : "Institutional partners"}>
  <p class="partner-colophon__about">{zh ? <><a href="/tw/">仁工智慧</a>：{site.description_zh}</> : <><a href="/">Civic AI</a>: {site.description}</>}</p>
  <nav class="partner-colophon__nav" aria-label={zh ? "網站區段（頁尾）" : "Site sections, repeated"}>
    {items.map((item) => <a href={item.href} aria-current={item.current}>{item.full}</a>)}
  </nav>
  <div class="partner-colophon__marks">
    <a href="https://www.oxford-aiethics.ox.ac.uk/"><img class="partner-logo partner-logo--oxford" width="100" height="100" src="/img/oxford-logo-light.svg" alt={zh ? "牛津 AI 倫理研究所" : "Oxford Institute for Ethics in AI"} loading="lazy" decoding="async" /></a>
    <a href="https://afp.oxford-aiethics.ox.ac.uk/"><img class="partner-logo partner-logo--afp" width="246" height="100" src="/img/afp-logo-light.svg" alt={zh ? "加速哲人計畫" : "Accelerator Fellowship Programme"} loading="lazy" decoding="async" /></a>
  </div>
  <p class="partner-colophon__caption">{zh ? <>目前的定義見<a href="/tw/glossary/">詞彙表</a>，各項主張的證據見<a href="/tw/sources/">文獻</a>。</> : <>Current definitions are in the <a href="/glossary/">glossary</a>, and the evidence behind each claim is in <a href="/sources/">Sources</a>.</>}</p>
  <p class="partner-colophon__caption">{zh ? <>CC0 公眾領域 · <a href="/tw/comics/">插圖</a>：<a href="https://ncase.me">Nicky Case</a> · 牛津 AI 倫理研究所「加速哲人計畫」研究成果。</> : <>CC0 public domain · <a href="/comics/">Illustration</a> by <a href="https://ncase.me">Nicky Case</a> · Oxford Institute for Ethics in AI, Accelerator Fellowship Programme.</>}</p>
  <p class="partner-colophon__caption partner-colophon__succession">{zh ? <>由本頁紀錄所列的守護者維護。若他們停止維護，這份紀錄仍然開放：完整原始碼與歷史以 CC0 留在 <a href="https://github.com/audreyt/civic.ai">GitHub</a>，任何人都能接續；每一次修改都記在<a href="/tw/ledger/">修訂紀錄</a>中。</> : <>Kept by the stewards named in this page's Trace. If they stop, the record stays open: the full source and its history remain on <a href="https://github.com/audreyt/civic.ai">GitHub</a> under CC0 for anyone to continue, and the <a href="/ledger/">amendment ledger</a> shows every change.</>}</p>
</section>
