---
import type { PageRecord } from "../lib/pages";
import { cssVersion, lang2, site } from "../lib/site";
import SeoHead from "./SeoHead.astro";

interface Props {
    page: PageRecord;
    ogType: "website" | "article";
}

const { page, ogType } = Astro.props;
const zh = lang2(page.data.lang) === "zh";
const ja = page.data.lang === "ja";
const siteDesc = zh ? site.description_zh || site.description : site.description;
const ogDesc = (page.data.meta_description || page.data.og_description || page.data.description || siteDesc).replace(/<[^>]+>/g, "");
const thumb = page.data.thumbnail;
const thumbSrc = typeof thumb === "string" ? thumb : thumb?.src;
// The default share card is 1200x630, the size link previews expect.
const fallbackImg = zh ? "/img/og-card-tw.jpg" : "/img/og-card.jpg";
const imagePath = page.data.og_image || thumbSrc || fallbackImg;
const ogImgAlt =
    imagePath === fallbackImg
        ? zh
            ? "civic.ai 關懷六力，附 Nicky Case 繪製的六力圖解概覽"
            : "The 6-Pack of Care on civic.ai, with Nicky Case's illustrated overview of the six packs"
        : undefined;
const ogImg = imagePath.includes("://") ? imagePath : `${site.url}${imagePath}`;
const pageTitle = `${page.data.title || site.title}${page.data.subtitle ? ` — ${page.data.subtitle}` : ""}`;
const version = cssVersion();
---
<meta charset="UTF-8" />
<script is:inline>
if (location.hostname === "6pack.care") location.replace("https://civic.ai" + location.pathname + location.search + location.hash);
</script>
<script is:inline>
(function(){try{var stored=localStorage.getItem("civic-ai-theme");var systemDark=window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches;var theme=stored==="light"||stored==="dark"?stored:systemDark?"dark":"light";document.documentElement.dataset.theme=theme;}catch(e){document.documentElement.dataset.theme="light";}})();
</script>
<script is:inline>
document.documentElement.classList.add("js");
// Web fonts can be blocked outright (iOS Lockdown Mode). The system fallback
// renders thinner at the same weight, so say so and let the stylesheet
// compensate rather than leaving the reader with faint text. Measuring is the
// only reliable test: fonts.check() reports a blocked face as available.
(function () {
    function settle() {
        var c = document.createElement("canvas").getContext("2d");
        var s = "civic ai care";
        c.font = '16px "Literata", monospace';
        var withFace = c.measureText(s).width;
        c.font = "16px monospace";
        if (withFace === c.measureText(s).width) document.documentElement.classList.add("fonts-unavailable");
    }
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(settle);
    else window.addEventListener("load", settle);
})();
// iOS Lockdown Mode stops decoding AVIF yet still picks a <picture>'s
// type="image/avif" source, so the image breaks. When an image inside a
// <picture> fails, drop its sources: the browser re-selects and loads the
// JPEG/PNG <img src> fallback. Image errors do not bubble, hence capture.
document.addEventListener("error", function (event) {
    var img = event.target;
    var picture = img && img.tagName === "IMG" ? img.parentNode : null;
    if (!picture || picture.tagName !== "PICTURE") return;
    var sources = picture.querySelectorAll("source");
    for (var i = 0; i < sources.length; i++) picture.removeChild(sources[i]);
}, true);
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#f8f4ed" />
<meta name="color-scheme" content="light dark" />
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title={zh ? "修訂紀錄" : "Amendment ledger"} />
<SeoHead page={page} ogType={ogType} ogDesc={ogDesc} ogImg={ogImg} ogImgAlt={ogImgAlt} pageTitle={pageTitle} />
{page.data.openclaw_discovery && <link rel="alternate" type="text/markdown" href="/.well-known/openclaw/SKILL.md" title="Civic AI Kami Bootstrap Skill" />}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="stylesheet" href={`/styles.css?v=${version}`} />
<link rel="preload" as="font" href="/fonts/literata-normal-latin.woff2" type="font/woff2" crossorigin />
<link rel="preload" as="font" href="/fonts/ibm-plex-mono-400-latin.woff2" type="font/woff2" crossorigin />
<script is:inline>
window.__userMoved=false;function __markMoved(){window.__userMoved=true}window.addEventListener('wheel',__markMoved,{passive:true,once:true});window.addEventListener('touchmove',__markMoved,{passive:true,once:true});window.addEventListener('keydown',__markMoved,{once:true});
</script>
