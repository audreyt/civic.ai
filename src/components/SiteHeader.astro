---
import type { PageRecord } from "../lib/pages";
import { formatDateDisplay, lang2 } from "../lib/site";
import { smartQuotes } from "../lib/legacyMarkdown";
import HeaderTools from "./HeaderTools.astro";
import SiteLogos from "./SiteLogos.astro";
import SiteNav from "./SiteNav.astro";
import SiteWordmark from "./SiteWordmark.astro";
import DayCompass from "./DayCompass.astro";
import HomeConstellation from "./HomeConstellation.astro";
import PackEyebrow from "./PackEyebrow.astro";

interface Props { page: PageRecord; headerTitle?: string; headerSubtitle?: string; headerDate?: string; }
const { page, headerTitle, headerSubtitle, headerDate } = Astro.props;
const isHome = page.url === "/" || page.url === "/tw/";
const zh = lang2(page.data.lang) === "zh";
const displayTitle = smartQuotes(String(headerTitle || page.data.header_title || page.data.title || ""));
const displaySubtitle = headerSubtitle || page.data.subtitle ? smartQuotes(String(headerSubtitle || page.data.subtitle)) : undefined;
const description = page.data.description ? smartQuotes(page.data.description) : undefined;
---
<header class:list={["site-header", isHome ? "site-header--home" : "site-header--interior"]}>
  {isHome ? (
    <>
      <HomeConstellation page={page} />
      <HeaderTools lang={page.data.lang} altLangUrl={page.data.alt_lang_url} />
      <SiteLogos lang={page.data.lang} />
      <h1><span class="title-keep">{displayTitle}</span>{displaySubtitle && <><span style="font-weight: 300">-</span><span class="title-keep">{displaySubtitle}</span></>}</h1>
      {description && <p set:html={description} />}
      {page.data.manifesto_link && <div class="header-cta-row"><a href={page.data.manifesto_link} class="next-action-button"><span class="button-text">{page.data.manifesto_text}</span></a><a href={zh ? "/tw/kami/" : "/kami/"} class="next-action-button"><span class="button-text">{zh ? "架設 Kami" : "Set up Kami"}</span></a></div>}
      <SiteNav lang={page.data.lang} />
    </>
  ) : (
    <>
      <div class="site-header__bar">
        <SiteWordmark lang={page.data.lang} />
        <DayCompass page={page} />
        <HeaderTools lang={page.data.lang} altLangUrl={page.data.alt_lang_url} />
        <div class="site-header__nav"><SiteNav lang={page.data.lang} /></div>
      </div>
      <div class="site-header__frame-rule" aria-hidden="true"></div>
      <div class="site-header__title-block">
        <PackEyebrow page={page} />
        <h1>{displayTitle}{displaySubtitle && <span>{displaySubtitle}</span>}</h1>
        <PackEyebrow page={page} part="question" />
        {headerDate ? <p class="chapter-date">{headerDate}</p> : page.data.date ? <p class="chapter-date">{formatDateDisplay(page.data.date, page.data.lang)}</p> : null}
        {page.data.author && <p class="chapter-date">{page.data.author}</p>}
        {description && <p set:html={description} />}
      </div>
    </>
  )}
</header>