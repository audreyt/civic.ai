---
import type { PageRecord } from "../lib/pages";
import { record, recordSources } from "../lib/record";
import { lang2 } from "../lib/site";
interface Props { page: PageRecord; }
const { page } = Astro.props;
const zh = lang2(page.data.lang) === "zh";
const amended = record.summary(recordSources(page));
const ledger = zh ? "/tw/ledger/" : "/ledger/";
---
<aside class="record-chip record-zone" aria-label={zh ? "本頁紀錄" : "Page record"} data-pagefind-ignore>
  {amended && <a href={ledger}>{zh ? "修訂 " : "Amended "}<time datetime={amended.amendedDate}>{amended.amendedDate.slice(0, 10)}</time></a>}
  <div data-record-evals="chip" data-record-lang={zh ? "zh" : "en"}></div>
</aside>
