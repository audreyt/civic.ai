---
import { navItems } from "../lib/nav";
import { lang2 } from "../lib/site";
const zh = lang2(Astro.props.lang) === "zh";
const items = navItems(Astro.props.lang, Astro.url.pathname);
---
<nav class="site-nav" aria-label={zh ? "網站區段" : "Site sections"}>
  {items.map((item) => <a href={item.href} aria-current={item.current}><span class="nav-label-full">{item.full}</span><span class="nav-label-short">{item.short}</span></a>)}
</nav>
