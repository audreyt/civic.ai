---
import { lang2 } from "../lib/site";
const zh = lang2(Astro.props.lang) === "zh";
const trimSlash = (path: string) =>
    path.length > 1 ? path.replace(/\/+$/, "") : path;
const currentPath = trimSlash(Astro.url.pathname);
const isCurrent = (href: string) =>
    !href.includes("#the-6-pack") &&
    trimSlash(href.split("#")[0]) === currentPath;
---
<nav class="site-nav" aria-label={zh ? "網站區段" : "Site sections"}>
  {zh ? <>
    <a href="/tw/" aria-current={isCurrent("/tw/") ? "page" : undefined}><span class="nav-label-full">首頁</span><span class="nav-label-short">首頁</span></a>
    <a href="/tw/manifesto/" aria-current={isCurrent("/tw/manifesto/") ? "page" : undefined}><span class="nav-label-full">計畫宣言</span><span class="nav-label-short">宣言</span></a>
    <a href="/tw/#the-6-pack" aria-current={isCurrent("/tw/#the-6-pack") ? "page" : undefined}><span class="nav-label-full">關懷六力</span><span class="nav-label-short">六力</span></a>
    <a href="/tw/measures/#map" aria-current={isCurrent("/tw/measures/#map") ? "page" : undefined}><span class="nav-label-full">地圖</span><span class="nav-label-short">地圖</span></a>
    <a href="/tw/faq/" aria-current={isCurrent("/tw/faq/") ? "page" : undefined}><span class="nav-label-full">常見問答</span><span class="nav-label-short">FAQ</span></a>
    <a href="/tw/glossary/" aria-current={isCurrent("/tw/glossary/") ? "page" : undefined}><span class="nav-label-full">詞彙表</span><span class="nav-label-short">詞彙</span></a>
    <a href="/tw/sources/" aria-current={isCurrent("/tw/sources/") ? "page" : undefined}><span class="nav-label-full">文獻</span><span class="nav-label-short">文獻</span></a>
  </> : <>
    <a href="/" aria-current={isCurrent("/") ? "page" : undefined}><span class="nav-label-full">Home</span><span class="nav-label-short">Home</span></a>
    <a href="/manifesto/" aria-current={isCurrent("/manifesto/") ? "page" : undefined}><span class="nav-label-full">Manifesto</span><span class="nav-label-short">Manifesto</span></a>
    <a href="/#the-6-pack" aria-current={isCurrent("/#the-6-pack") ? "page" : undefined}><span class="nav-label-full">The 6-Pack</span><span class="nav-label-short">6-Pack</span></a>
    <a href="/measures/#map" aria-current={isCurrent("/measures/#map") ? "page" : undefined}><span class="nav-label-full">Map</span><span class="nav-label-short">Map</span></a>
    <a href="/faq/" aria-current={isCurrent("/faq/") ? "page" : undefined}><span class="nav-label-full">FAQ</span><span class="nav-label-short">FAQ</span></a>
    <a href="/glossary/" aria-current={isCurrent("/glossary/") ? "page" : undefined}><span class="nav-label-full">Glossary</span><span class="nav-label-short">Glossary</span></a>
    <a href="/sources/" aria-current={isCurrent("/sources/") ? "page" : undefined}><span class="nav-label-full">Sources</span><span class="nav-label-short">Sources</span></a>
  </>}
</nav>
