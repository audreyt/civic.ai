---
// DayCompassClient (DESIGN.md §21): reading progress through #main fills the
// arc around the current pack dot. Without JS, or under reduced motion, the
// current dot is simply filled.
import type { PageRecord } from "../../lib/pages";
interface Props { page: PageRecord; }
---
<script is:inline>
(function () {
    try {
        var nav = document.querySelector("[data-day-compass]");
        if (!nav || nav.getAttribute("data-dc-bound") === "1") return;
        var arc = nav.querySelector(".day-compass__arc");
        var main = document.getElementById("main");
        if (!arc || !main) return;
        nav.setAttribute("data-dc-bound", "1");
        if (
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        )
            return;
        var circ = parseFloat(arc.getAttribute("data-circ") || "35.19");
        var ticking = false;
        function paint() {
            ticking = false;
            var box = main.getBoundingClientRect();
            var span = box.height - window.innerHeight;
            var p = span > 0 ? -box.top / span : 1;
            p = Math.max(0, Math.min(1, p));
            arc.style.strokeDashoffset = String(circ * (1 - p));
            nav.setAttribute("data-progress", String(Math.round(p * 100)));
        }
        function onScroll() {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(paint);
        }
        nav.classList.add("day-compass--live");
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        paint();
    } catch (e) {}
})();
</script>
