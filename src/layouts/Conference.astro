---
import { hasPublicFile, visibleHtml, type PageRecord } from "../lib/pages";
import { avifSibling, smartQuotes } from "../lib/legacyMarkdown";
import { lang2, site } from "../lib/site";
import { normalizeSearchLang } from "../lib/search";
import ClientScripts from "../components/ClientScripts.astro";
import PageHead from "../components/PageHead.astro";
import PartnerColophon from "../components/PartnerColophon.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SearchOverlay from "../components/SearchOverlay.astro";

interface Props { page: PageRecord; }
const { page } = Astro.props;
const zh = lang2(page.data.lang) === "zh";
const data = page.data as any;
const UNTOUCHED_KEYS = new Set(["url", "src", "href", "photo", "alt_lang_url", "permalink"]);
const smart = (value: any, key = ""): any =>
    typeof value === "string"
        ? UNTOUCHED_KEYS.has(key) ? value : smartQuotes(value)
        : Array.isArray(value)
          ? value.map((item) => smart(item))
          : value && typeof value === "object"
            ? Object.fromEntries(Object.entries(value).map(([k, v]) => [k, smart(v, k)]))
            : value;
const shown = smart(data);
const avif = (src: string) => avifSibling(src, hasPublicFile);
const pagefindIndexed =
    page.includeInSitemap === true &&
    page.data.search_exclude !== true &&
    normalizeSearchLang(page.data.lang) === "en";
const eventLd = {"@context":"https://schema.org","@type":"Event",name:`${data.title} — ${data.subtitle}`,url:`${site.url}${page.url}`,description:data.meta_description||data.description,startDate:"2026-03-25",eventStatus:"https://schema.org/EventScheduled",eventAttendanceMode:"https://schema.org/OfflineEventAttendanceMode",image:data.og_image?`${site.url}${data.og_image}`:`${site.url}/img/overview-small.jpg`,location:{"@type":"Place",name:"Rhodes House",address:{"@type":"PostalAddress",streetAddress:"South Park Road",addressLocality:"Oxford",addressCountry:"GB"}},organizer:{"@type":"Organization",name:"Oxford Institute for Ethics in AI",url:"https://www.oxford-aiethics.ox.ac.uk/"}};
---
<!doctype html>
<html lang={page.data.lang || "en"}>
<head><PageHead page={page} ogType="website" preloadFont="/fonts/outfit-latin.woff2" /></head>
<body>
<a class="skip-link" href="#main">{zh ? "跳至內容" : "Skip to content"}</a>
<SiteHeader page={page} headerTitle={shown.subtitle} headerSubtitle={shown.title} headerDate={shown.date_line} />
<SearchOverlay page={page} />
<main
  id="main"
  {...(pagefindIndexed
    ? {
          "data-pagefind-body": true,
          "data-pagefind-filter": `lang:${normalizeSearchLang(page.data.lang)}`,
          "data-pagefind-meta": `section:${page.data.title || page.url}`,
      }
    : {})}
>
  <div class="conf-hosts">
    {(shown.hosts || []).map((host: any) => (
      <a href={host.url} class="conf-host">
        <picture>{avif(host.photo.src) && <source srcset={avif(host.photo.src)} type="image/avif" />}<img src={host.photo.src} alt="" width={host.photo.w} height={host.photo.h} loading="lazy" decoding="async" /></picture>
        <strong>{host.name}</strong>
        <span>{host.role}</span>
      </a>
    ))}
  </div>
  {shown.goals && <h2 class="visually-hidden">{zh ? "研討會目標" : "Conference goals"}</h2>}
  <div class="conf-goals">{(shown.goals || []).map((goal: any, i: number) => <div class="conf-goal"><span class="conf-goal-num">{String(i + 1).padStart(2, "0")}</span><h3>{goal.title}</h3><p>{goal.text}</p></div>)}</div>
  {shown.agenda_title && <h2>{shown.agenda_title}</h2>}
  <div class="conf-agenda">
    {(shown.agenda || []).map((slot: any) => (
      <div class:list={["conf-slot", slot.break && "conf-break"]}>
        <div class="conf-time">{slot.time}</div>
        <div class="conf-detail">
          {slot.photos && (
            <div class="conf-panel-photos">
              {slot.photos.map((p: any) => (
                <picture>{avif(p.src) && <source srcset={avif(p.src)} type="image/avif" />}<img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" /></picture>
              ))}
            </div>
          )}
          {slot.photo ? (
            <div class="conf-detail-with-photo">
              <picture>{avif(slot.photo.src) && <source srcset={avif(slot.photo.src)} type="image/avif" />}<img src={slot.photo.src} alt={slot.photo.alt} width={slot.photo.w} height={slot.photo.h} loading="lazy" decoding="async" /></picture>
              <div class="conf-detail-text">
                <div class="conf-title">{slot.url ? <a href={slot.url}>{slot.title}</a> : slot.title}</div>
                {slot.speaker && <div class="conf-speaker">{slot.speaker}</div>}
                {slot.description && <div class="conf-desc">{slot.description}</div>}
              </div>
            </div>
          ) : (
            <>
              <div class="conf-title">{slot.url ? <a href={slot.url}>{slot.title}</a> : slot.title}</div>
              {slot.speaker && <div class="conf-speaker">{slot.speaker}</div>}
              {slot.description && <div class="conf-desc">{slot.description}</div>}
            </>
          )}
        </div>
      </div>
    ))}
  </div>
  <Fragment set:html={visibleHtml(page)} />
  {shown.packs_title && <h2>{shown.packs_title}</h2>}
  {shown.packs_intro && <p style="font-size: 0.95rem">{shown.packs_intro} <a href={shown.packs_link_url}>{shown.packs_link_text}</a>{shown.packs_period}</p>}
  <div class="conf-packs-condensed">{(shown.packs || []).map((pack: any) => <a href={pack.url}><strong>{pack.num}</strong> {pack.name}</a>)}</div>
  {shown.overview_image && (
    <div class="conf-diagram">
      <picture>{avif(shown.overview_image.src) && <source srcset={avif(shown.overview_image.src)} type="image/avif" />}<img src={shown.overview_image.src} alt={shown.overview_image.alt} width={shown.overview_image.w} height={shown.overview_image.h} loading="lazy" decoding="async" /></picture>
    </div>
  )}
</main>
<PartnerColophon lang={page.data.lang} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(eventLd)}></script>
<ClientScripts page={page} />
</body>
</html>