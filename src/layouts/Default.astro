---
import { visibleHtml, type PageRecord } from "../lib/pages";
import DefaultShell from "./DefaultShell.astro";
import Ledger from "../components/Ledger.astro";
interface Props { page: PageRecord; }
const { page } = Astro.props;
---
<DefaultShell page={page}>{page.data.page_class === "ledger-page" ? <Ledger page={page} /> : <Fragment set:html={visibleHtml(page)} />}</DefaultShell>
